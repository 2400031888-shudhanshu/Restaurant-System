# Copy this file to .env and fill in your own values. Never commit .env.
DB_HOST=localhost
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=restaurant_db
DB_PORT=3306
PORT=5000

# Required. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# UPI checkout (leave UPI_VPA empty to show "not configured")
UPI_VPA=
UPI_PAYEE_NAME=Your Restaurant

# Optional email alerts. Gmail needs an App Password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
ORDER_ALERT_EMAIL=
FEEDBACK_EMAIL=
